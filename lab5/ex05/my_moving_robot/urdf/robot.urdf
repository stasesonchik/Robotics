<?xml version="1.0"?>
<robot name="my_first_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- include gazebo settings if you have them -->
  <xacro:include filename="$(find my_moving_robot)/urdf/gazebo.urdf.xacro" />

  <!-- === PARAMETERS === -->
  <xacro:property name="base_radius" value="0.4"/>
  <xacro:property name="base_height" value="1.2"/>

  <xacro:property name="wheel_length" value="0.08"/>
  <xacro:property name="wheel_radius" value="0.3"/>
  <xacro:property name="wheel_mass" value="1.5"/>

  <xacro:property name="caster_wheel_length" value="0.05"/>
  <xacro:property name="caster_wheel_radius" value="${wheel_radius/2 - 0.01}"/>
  <xacro:property name="caster_wheel_mass" value="0.3"/>

  <xacro:property name="upper_arm_length" value="0.35"/>
  <xacro:property name="upper_arm_radius" value="0.05"/>
  <xacro:property name="forearm_length" value="0.3"/>
  <xacro:property name="forearm_radius" value="0.04"/>

  <xacro:property name="base_mass" value="15.0"/>
  <xacro:property name="chassis_mass" value="0.0"/> <!-- we keep chassis geometry inside 'chassis' link -->

  <!-- useful derived properties -->
  <!-- distance from base center to wheel center (approx) -->
  <xacro:property name="wheel_offset_y" value="${base_radius}"/>
  <xacro:property name="wheel_offset_x" value="0"/>
  <xacro:property name="wheel_offset_z" value="0"/>

  <!-- === MATERIALS === -->
  <material name="body_color">
    <color rgba="0.2 0.5 0.8 1"/>
  </material>

  <material name="wheel_color">
    <color rgba="0.3 0.3 0.3 1"/>
  </material>

  <material name="caster_wheel_color">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>

  <material name="arm_color">
    <color rgba="0.8 0.6 0.2 1"/>
  </material>

  <!-- === ROOT FRAMES (etalon style) === -->
  <link name="base_link"/>
  <link name="base_footprint"/>

  <!-- base_footprint is the projection on the floor (attached to base_link) -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <!-- place footprint at bottom of base cylinder -->
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- === CHASSIS (visual: vertical cylinder) === -->
  <!-- chassis is a child of base_link so TF chain is: base_link -> chassis -> wheels -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <!-- place chassis so that cylinder base rests at base_link origin plane -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="chassis">
    <visual>
      <!-- cylinder oriented along Z (length = height) -->
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${base_height}" radius="${base_radius}"/>
      </geometry>
      <material name="body_color"/>
    </visual>

    <collision>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${base_height}" radius="${base_radius}"/>
      </geometry>
    </collision>

    <inertial>
      <!-- approximate cylinder inertia about center (using base_mass) -->
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <!-- coarse inertial approximation for a solid cylinder aligned with Z -->
      <!-- Ixx = Iyy = 1/12 m (3r^2 + h^2), Izz = 1/2 m r^2 -->
      <inertia ixx="${(1.0/12.0)*base_mass*(3*base_radius*base_radius + base_height*base_height)}"
               ixy="0.0" ixz="0.0"
               iyy="${(1.0/12.0)*base_mass*(3*base_radius*base_radius + base_height*base_height)}"
               iyz="0.0"
               izz="${0.5*base_mass*base_radius*base_radius}"/>
    </inertial>
  </link>

  <gazebo reference="chassis">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- === WHEELS (left / right) === -->
  <xacro:macro name="wheel" params="prefix y_reflect">
    <link name="${prefix}_link">
      <visual>
        <!-- wheel cylinder length along x when rotated by rpy below -->
        <origin xyz="0 0 0" rpy="1.57075 0 0"/>
        <geometry>
          <cylinder length="${wheel_length}" radius="${wheel_radius}"/>
        </geometry>
        <material name="wheel_color"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.57075 0 0"/>
        <geometry>
          <cylinder length="${wheel_length}" radius="${wheel_radius}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <!-- approximate inertia of thin cylinder (about central axes) -->
        <inertia ixx="${(1.0/12.0)*wheel_mass*(3*wheel_radius*wheel_radius + wheel_length*wheel_length)}"
                 ixy="0" ixz="0"
                 iyy="${(1.0/12.0)*wheel_mass*(3*wheel_radius*wheel_radius + wheel_length*wheel_length)}"
                 iyz="0"
                 izz="${0.5*wheel_mass*wheel_radius*wheel_radius}"/>
      </inertial>
    </link>

    <joint name="base_to_${prefix}" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_link"/>
      <!-- place wheel at same height as base_link origin (z=0). y offset left/right -->
      <origin xyz="${wheel_offset_x} ${y_reflect * wheel_offset_y} ${wheel_offset_z}" rpy="0 0 0"/>
      <!-- wheel rotation axis: around Y in original file; to act like etalon, use Z-axis after rpy -->
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${prefix}_link">
      <material>Gazebo/Grey</material>
    </gazebo>
  </xacro:macro>

  <!-- two driving wheels -->
  <xacro:wheel prefix="left_wheel"  y_reflect="1"/>
  <xacro:wheel prefix="right_wheel" y_reflect="-1"/>

  <!-- === CASTER WHEELS === -->
  <xacro:macro name="caster_wheel" params="prefix x_reflect y_pos">
    <link name="${prefix}_caster_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_wheel_radius}"/>
        </geometry>
        <material name="caster_wheel_color"/>
      </visual>
      <collision>
        <geometry>
          <sphere radius="${caster_wheel_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="${caster_wheel_mass}"/>
        <inertia ixx="${(2.0/5.0)*caster_wheel_mass*caster_wheel_radius*caster_wheel_radius}" ixy="0" ixz="0"
                 iyy="${(2.0/5.0)*caster_wheel_mass*caster_wheel_radius*caster_wheel_radius}" iyz="0"
                 izz="${(2.0/5.0)*caster_wheel_mass*caster_wheel_radius*caster_wheel_radius}"/>
      </inertial>
    </link>

    <joint name="base_to_${prefix}_caster" type="fixed">
      <parent link="chassis"/>
      <child link="${prefix}_caster_wheel"/>
      <!-- place caster at front/back along x and at requested lateral position -->
      <origin xyz="${x_reflect*(base_radius - 0.1)} ${y_pos} ${-caster_wheel_radius}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${prefix}_caster_wheel">
      <material>Gazebo/White</material>
      <mu1 value="0.01"/>
      <mu2 value="0.01"/>
    </gazebo>
  </xacro:macro>

  <!-- front and rear casters (two symmetric along y=0) -->
  <xacro:caster_wheel prefix="front" x_reflect="1"  y_pos="0" />
  <xacro:caster_wheel prefix="rear"  x_reflect="-1" y_pos="0" />

  <!-- === ARMS (kept from original, adapted to etalon style) === -->
  <xacro:macro name="arm" params="prefix y_reflect">
    <!-- upper arm link -->
    <link name="${prefix}_upper_arm_link">
      <visual>
        <!-- cylinder along Z by default, put its center so that the shoulder joint is at top -->
        <origin xyz="0 0 ${-upper_arm_length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder length="${upper_arm_length}" radius="${upper_arm_radius}"/>
        </geometry>
        <material name="arm_color"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-upper_arm_length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder length="${upper_arm_length}" radius="${upper_arm_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${-upper_arm_length/2}" rpy="0 0 0"/>
        <mass value="0.8"/>
        <inertia ixx="0.01" ixy="0" ixz="0"
                 iyy="0.01" iyz="0"
                 izz="0.001"/>
      </inertial>
    </link>

    <!-- shoulder joint: attach to base_link so arms move with whole robot body -->
    <joint name="${prefix}_shoulder_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_upper_arm_link"/>
      <origin xyz="0 ${y_reflect * base_radius} ${base_height * 0.7}" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
    </joint>

    <!-- forearm -->
    <link name="${prefix}_forearm_link">
      <visual>
        <origin xyz="0 0 ${-forearm_length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder length="${forearm_length}" radius="${forearm_radius}"/>
        </geometry>
        <material name="arm_color"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-forearm_length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder length="${forearm_length}" radius="${forearm_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${-forearm_length/2}" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.008" ixy="0" ixz="0"
                 iyy="0.008" iyz="0"
                 izz="0.0008"/>
      </inertial>
    </link>

    <joint name="${prefix}_elbow_joint" type="revolute">
      <parent link="${prefix}_upper_arm_link"/>
      <child link="${prefix}_forearm_link"/>
      <origin xyz="0 0 ${-upper_arm_length}" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="0" upper="2.0" effort="5.0" velocity="1.0"/>
    </joint>
  </xacro:macro>

  <!-- left and right arms -->
  <xacro:arm prefix="left_arm"  y_reflect="1"/>
  <xacro:arm prefix="right_arm" y_reflect="-1"/>

</robot>
